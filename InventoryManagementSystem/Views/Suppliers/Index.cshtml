@model List<InventoryManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-0">Suppliers</h2>
        <p class="text-muted mb-0">Manage your suppliers</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> + Add Supplier
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h5 class="fw-semibold mb-2">No suppliers found.</h5>
            <p class="text-muted mb-4">Start by adding your first supplier.</p>
            <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Supplier Name</th>
                        <th>Contact Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@supplier.SupplierName</td>
                            <td>@(supplier.ContactName ?? "-")</td>
                            <td>@(supplier.Phone ?? "-")</td>
                            <td>@(supplier.Email ?? "-")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@supplier.SupplierId"
                                       class="btn btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@supplier.SupplierId"
                                       class="btn btn-outline-primary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@supplier.SupplierId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this supplier?');">
                                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
