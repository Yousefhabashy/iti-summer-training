@model InventoryManagementSystem.ViewModels.Products.ProductListVm

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-auto">
        <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or SKU" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">All Categories</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="ok" selected="@(Model.StatusFilter == "ok")">In Stock</option>
            <option value="low" selected="@(Model.StatusFilter == "low")">Low Stock</option>
            <option value="out" selected="@(Model.StatusFilter == "out")">Out of Stock</option>
        </select>
    </div>
    <div class="col-auto form-check">
        <input type="checkbox" id="showInactive" name="showInactive" class="form-check-input" value="true" checked="@Model.ShowInactive" />
        <label class="form-check-label" for="showInactive">Show inactive products</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Status</th>
            <th>Details</th>
            <th>Edit</th>
            <th>Remove</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr class="@(!product.IsActive ? "table-secondary" : "")">
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Sku</td>
                <td>@product.UnitPrice.ToString("C")</td>
                <td>@product.StockQuantity</td>
                <td>@product.Category?.CategoryName</td>
                <td>
                    @if (!product.IsActive)
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                    else if (product.StockQuantity == 0)
                    {
                        <span class="badge bg-danger">Out of Stock</span>
                    }
                    else if (product.StockQuantity < product.LowStockThreshold)
                    {
                        <span class="badge bg-warning text-dark">Low Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Available</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-primary">Details</a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-primary">Edit</a>
                </td>
                <td>
                    @if (product.IsActive)
                    {
                        <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">Remove</a>
                    }
                    else
                    {
                        <form asp-action="Reactivate" asp-route-id="@product.ProductId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a asp-action="Index"
           asp-route-page="@i"
           asp-route-search="@Model.SearchTerm"
           asp-route-categoryId="@Model.CategoryFilter"
           asp-route-status="@Model.StatusFilter"
           asp-route-showInactive="@Model.ShowInactive"
           class="btn @(i == Model.PageNumber ? "btn-primary" : "btn-outline-primary")">@i</a>
    }
</div>

<br />
<a asp-action="Create" class="btn btn-success">Add Product</a>