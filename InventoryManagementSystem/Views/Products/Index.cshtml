@model InventoryManagementSystem.ViewModels.Products.ProductListVm

@{
    ViewData["Title"] = "Products";
}

<style>
    .products-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 25px;
    }

    .product-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .product-card:hover {
            box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        }

        .product-card.inactive-card {
            opacity: 0.6;
        }

    .product-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .product-info {
        margin-bottom: 8px;
        color: #555;
    }

    .price {
        font-size: 20px;
        font-weight: bold;
        color: #0d6efd;
        margin: 15px 0;
    }

    .status {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
        margin-bottom: 15px;
    }

    .available {
        background: #e8f7ee;
        color: #198754;
    }

    .out-of-stock {
        background: #fdeaea;
        color: #dc3545;
    }

    .low-stock {
        background: #fff8e5;
        color: #b8860b;
    }

    .inactive {
        background: #eceff1;
        color: #607d8b;
    }

    .card-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

        .card-actions a, .card-actions button {
            flex: 1;
            text-align: center;
            padding: 9px 5px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s;
            border: none;
        }

    .btn-details {
        background: #f1f3f5;
        color: #333;
    }

        .btn-details:hover {
            background: #e0e4e8;
            color: #333;
        }

    .btn-edit {
        background: #0d6efd;
        color: white;
    }

        .btn-edit:hover {
            background: #0b5ed7;
            color: white;
        }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

        .btn-delete:hover {
            background: #b02a37;
            color: white;
        }

    .btn-reactivate {
        background: #198754;
        color: white;
    }

        .btn-reactivate:hover {
            background: #157347;
            color: white;
        }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 10px;
        margin-bottom: 20px;
    }

    .search-wrapper {
        flex: 1;
        max-width: 500px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-input {
        flex: 1;
        min-width: 180px;
        padding: 11px 18px;
        border: 1px solid #ddd;
        border-radius: 25px;
        outline: none;
        transition: all 0.2s;
        font-size: 15px;
    }

        .search-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }

    .filter-select {
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 25px;
        font-size: 14px;
    }

    .btn-add-product {
        padding: 11px 30px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        white-space: nowrap;
    }

    .pagination-container {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        gap: 6px;
    }

        .pagination-container a {
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            background: white;
            border: 1px solid #ddd;
            color: #333;
            transition: all 0.2s;
        }

            .pagination-container a:hover {
                background: #0d6efd;
                color: white;
                border-color: #0d6efd;
            }

            .pagination-container a.active {
                background: #0d6efd;
                color: white;
                border-color: #0d6efd;
            }

    .toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
    }

    .toast {
        min-width: 300px;
    }

    @@media (max-width: 768px) {
        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-wrapper {
            max-width: 100%;
        }

        .btn-add-product {
            width: 100%;
            text-align: center;
        }

        .products-container {
            grid-template-columns: 1fr;
        }
    }

    @@media (min-width: 769px) and (max-width: 1200px) {
        .products-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="toast-container">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-white bg-success border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-white bg-danger border-0 show" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>

<h2><i class="bi bi-box me-2 text-primary"></i>Products</h2>
<hr />

<div class="toolbar">
    <form asp-action="Index" method="get" class="search-wrapper">
        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search with Product Name or SKU" class="search-input" />

        <select name="categoryId" class="filter-select" asp-items="ViewBag.Categories">
            <option value="">All Categories</option>
        </select>

        <select name="status" class="filter-select">
            <option value="">All Status</option>
            <option value="ok" selected="@(Model.StatusFilter == "ok")">In Stock</option>
            <option value="low" selected="@(Model.StatusFilter == "low")">Low Stock</option>
            <option value="out" selected="@(Model.StatusFilter == "out")">Out of Stock</option>
        </select>

        <label class="filter-select d-flex align-items-center gap-2">
            <input type="checkbox" name="showInactive" value="true" checked="@Model.ShowInactive" /> Inactive
        </label>

        <button type="submit" class="btn btn-primary" style="border-radius: 25px; padding: 8px 24px;">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 25px; padding: 8px 24px;">Clear</a>
    </form>

    <div>
        <a asp-action="Create" class="btn btn-primary btn-add-product"><i class="bi bi-plus-circle me-1"></i> Add Product</a>
    </div>
</div>

<div class="products-container">
    @foreach (var product in Model.Products)
    {
        <div class="product-card @(!product.IsActive ? "inactive-card" : "")">
            <div class="product-title">
                <strong>Name:</strong> @product.ProductName
            </div>

            <div class="product-info">
                <strong>ID:</strong> @product.ProductId
            </div>

            <div class="product-info">
                <strong>SKU:</strong> @product.Sku
            </div>

            <div class="product-info">
                <strong>Stock Quantity:</strong> @product.StockQuantity
            </div>

            <div class="product-info">
                <strong>Category:</strong> @product.Category?.CategoryName
            </div>

            <div class="price">
                @product.UnitPrice.ToString("C")
            </div>

            @if (!product.IsActive)
            {
                <span class="status inactive">Inactive</span>
            }
            else if (product.StockQuantity == 0)
            {
                <span class="status out-of-stock">Out of Stock</span>
            }
            else if (product.StockQuantity < product.LowStockThreshold)
            {
                <span class="status low-stock">Low Stock</span>
            }
            else
            {
                <span class="status available">Available</span>
            }

            <div class="card-actions">
                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn-details"><i class="bi bi-eye"></i> Details</a>
                <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn-edit"><i class="bi bi-pencil"></i> Edit</a>
                @if (product.IsActive)
                {
                    <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn-delete"><i class="bi bi-trash"></i> Delete</a>
                }
                else
                {
                    <form asp-action="Reactivate" asp-route-id="@product.ProductId" method="post" style="flex:1;">
                        <button type="submit" class="btn-reactivate w-100"><i class="bi bi-arrow-counterclockwise"></i> Reactivate</button>
                    </form>
                }
            </div>
        </div>
    }
</div>

@if (!Model.Products.Any())
{
    <div class="text-center mt-5 py-5">
        <i class="bi bi-inbox fs-1 text-muted"></i>
        <h4 class="text-muted mt-3">No products found</h4>
        <p class="text-muted">Try adjusting your search or add a new product.</p>
        <a asp-action="Create" class="btn btn-primary mt-2"><i class="bi bi-plus-circle me-1"></i> Add New Product</a>
    </div>
}

@if (Model.TotalPages > 1)
{
    <div class="pagination-container">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-search="@Model.SearchTerm"
               asp-route-categoryId="@Model.CategoryFilter"
               asp-route-status="@Model.StatusFilter"
               asp-route-showInactive="@Model.ShowInactive"
               class="@(i == Model.PageNumber ? "active" : "")">@i</a>
        }
    </div>
}

<br />