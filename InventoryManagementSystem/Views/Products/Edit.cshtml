@model InventoryManagementSystem.ViewModels.Products.EditProductVm

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ProductId" />

    <div class="mt-3">
        <label>Product Name</label>
        <input type="text" class="form-control" asp-for="ProductName" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>
    <br />

    <div class="mt-3">
        <label>Stock Keeping Unit</label>
        <input type="text" asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="text-danger"></span>
    </div>
    <br />

    <div class="mt-3">
        <label>Price</label>
        <input type="number" asp-for="UnitPrice" step="0.01" class="form-control" />
        <span asp-validation-for="UnitPrice" class="text-danger"></span>
    </div>
    <br />

    <div class="mt-3">
        <label>Stock Quantity</label>
        <input type="number" asp-for="StockQuantity" class="form-control" />
        <span asp-validation-for="StockQuantity" class="text-danger"></span>
    </div>
    <br />

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">Select Category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <br />

    <div class="mt-3">
        <label>Low Stock Threshold</label>
        <input type="number" asp-for="LowStockThreshold" class="form-control" />
        <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
    </div>
    <br />
    <br />

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}