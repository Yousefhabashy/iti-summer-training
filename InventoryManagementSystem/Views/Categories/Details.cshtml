@model InventoryManagementSystem.ViewModels.Categories.CategoryVm

@{
    ViewData["Title"] = "Category Details";
}

<style>
    .details-container{
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
    }

    .category-icon{
        text-align: center;
        font-size: 80px;
        color: #0d6efd;
        margin-bottom: 20px;
    }

    .details-card{
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .details-card .detail-row{
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .details-card .detail-row:last-child{
        border-bottom: none;
    }

    .details-card .label{
        font-weight: 600;
        color: #555;
    }

    .details-card .value{
        color: #333;
    }

    .action-buttons{
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 25px;
    }

    .action-buttons .btn{
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: 600;
        min-width: 120px;
    }

    .btn-back{
        background: #6c757d;
        color: white;
        border: none;
    }

    .btn-back:hover{
        background: #5a6268;
        color: white;
    }

    .btn-edit{
        background: #0d6efd;
        color: white;
        border: none;
    }

    .btn-edit:hover{
        background: #0b5ed7;
        color: white;
    }

    .badge-product{
        background: #e8f0fe;
        color: #0d6efd;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 14px;
    }
</style>

<div class="details-container">

    <h2 class="text-center mb-4">@Model.CategoryName</h2>

    <div class="details-card">
        <div class="detail-row">
            <span class="label"> ID</span>
            <span class="value">@Model.CategoryId</span>
        </div>
        <div class="detail-row">
            <span class="label"> Category Name</span>
            <span class="value">@Model.CategoryName</span>
        </div>
        <div class="detail-row">
            <span class="label"> Description</span>
            <span class="value">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</span>
        </div>
        <div class="detail-row">
            <span class="label"> Number of Products</span>
            <span class="value">
                <span class="badge-product"> @Model.ProductCount Products</span>
            </span>
        </div>
    </div>

    <div class="action-buttons">
        <a asp-action="Index" class="btn btn-back"> Back</a>
        
    </div>
</div>