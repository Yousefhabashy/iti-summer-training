@model IEnumerable<InventoryManagementSystem.ViewModels.Categories.CategoryVm>
<style>
    .categories-container{
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 25px;
    }

    .category-card{
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        transition: all 0.3s;
        position: relative;
    }

    .category-card:hover{
        box-shadow: 0 6px 18px rgba(0,0,0,0.12);
        transform: translateY(-3px);
    }

    .category-icon{
        font-size: 45px;
        color: #0d6efd;
        margin-bottom: 12px;
    }

    .category-name{
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .category-description{
        color: #666;
        font-size: 14px;
        margin-bottom: 12px;
        min-height: 40px;
    }

    .product-count{
        display: inline-block;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 13px;
        background: #e8f0fe;
        color: #0d6efd;
        margin-bottom: 15px;
    }

    .card-actions{
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .card-actions a{
        flex: 1;
        text-align: center;
        padding: 8px 5px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.2s;
    }

    .btn-details{
        background: #f1f3f5;
        color: #333;
    }

    .btn-details:hover{
        background: #e0e4e8;
        color: #333;
    }

    .btn-edit{
        background: #0d6efd;
        color: white;
    }

    .btn-edit:hover{
        background: #0b5ed7;
        color: white;
    }

    .btn-delete{
        background: #dc3545;
        color: white;
    }

    .btn-delete:hover{
        background: #b02a37;
        color: white;
    }

    .toolbar{
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 10px;
        margin-bottom: 20px;
    }
    
    .btn-add-category{
        padding: 11px 30px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 15px;
        white-space: nowrap;
    }

    .pagination-container{
        margin-top: 30px;
        display: flex;
        justify-content: center;
        gap: 6px;
    }

     .pagination-container a{
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 8px;
        background: white;
        border: 1px solid #ddd;
        color: #333;
        transition: all 0.2s;
    }

    .pagination-container a:hover{
        background: #0d6efd;
        color: white;
        border-color: #0d6efd;
    }

    .pagination-container a.active{
        background: #0d6efd;
        color: white;
        border-color: #0d6efd;
    }

    .empty-state{
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state i{
        font-size: 80px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .empty-state h4{
        color: #666;
    }

    .empty-state p{
        color: #999;
    }

    .alert{
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px){
        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }
        .btn-add-category{
            width: 100%;
            text-align: center;
        }

        .categories-container{
            grid-template-columns: 1fr;
        }
    }

    @@media (min-width: 769px) and (max-width: 1200px){
        .categories-container{
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<h2><i class="bi bi-tags me-2 text-primary"></i>Categories</h2>

<hr />

@if(TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if(TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="toolbar">
        <a asp-action="Create" class="btn btn-primary btn-add-category"><i class="bi bi-plus-circle me-1"></i> Add Category</a>
</div>

<div class="categories-container">
    @foreach(var category in Model)
    {
        <div class="category-card">

            <div class="category-name">
                @category.CategoryName
            </div>

            <div class="category-description">
                @(string.IsNullOrEmpty(category.Description) ? "No description" : category.Description)
            </div>

            <div class="product-count">
                <i class="bi bi-box me-1"></i> @category.ProductCount Products
            </div>

            <div class="card-actions">
                <a asp-action="Details" asp-route-id="@category.CategoryId" class="btn-details"> <i class="bi bi-eye"></i> Details</a>
                <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn-edit"><i class="bi bi-pencil"></i> Edit</a>
                <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn-delete"><i class="bi bi-trash"></i> Delete </a>
            </div>
        </div>
    }
</div>


@if(ViewBag.TotalPage>1)
{
    <div class="pagination-container">
        @for (int i=1;i<=ViewBag.TotalPage;i++)
        {
            <a asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@ViewBag.SearchTerm" class="@(i == ViewBag.CurrentPage ? "active" : "")">@i </a>
        }
    </div>
}