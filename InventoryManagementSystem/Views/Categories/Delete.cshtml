@model InventoryManagementSystem.ViewModels.Categories.CategoryVm

@{
    ViewData["Title"] = "Delete Category";
}

<style>
    .delete-container{
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
    }

    .warning-box{
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .warning-box i{
        font-size: 40px;
        color: #ffc107;
    }

    .warning-box h5{
        margin: 0;
        color: #856404;
    }

    .warning-box p{
        margin: 5px 0 0 0;
        color: #856404;
    }

    .category-details{
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 25px;
    }

    .category-details .detail-row{
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .category-details .detail-row:last-child{
        border-bottom: none;
    }

    .category-details .label{
        font-weight: 600;
        color: #555;
    }

    .category-details .value{
        color: #333;
    }

    .error-message{
        background: #f8d7da;
        border: 1px solid #f5c2c7;
        border-radius: 12px;
        padding: 15px 20px;
        color: #842029;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .error-message i{
        font-size: 24px;
    }

    .action-buttons{
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 20px;
    }

    .action-buttons .btn{
        padding: 10px 35px;
        border-radius: 8px;
        font-weight: 600;
        min-width: 120px;
    }

    .btn-cancel{
        background: #6c757d;
        color: white;
        border: none;
        transition: all 0.2s;
    }

    .btn-cancel:hover{
        background: #5a6268;
        color: white;
    }

    .btn-delete-category{
        background: #dc3545;
        color: white;
        border: none;
        transition: all 0.2s;
    }

    .btn-delete-category:hover{
        background: #b02a37;
        color: white;
    }

    .btn-delete-category:disabled{
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<div class="delete-container">
    <h2 class="text-center mb-4">Delete Category</h2>

    @if(Model.HasProducts)
    {
        <div class="error-message">
            <div>
                <strong>Cannot delete this category!</strong>
                <p class="mb-0">This category contains <strong>@Model.ProductCount</strong> product.<br /> Please remove or reassign products first.</p>
            </div>
        </div>

        <div class="text-center">
            <a asp-action="Index" class="btn btn-secondary"> Back</a>
        </div>
    }
    else
    {
        <div class="warning-box">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <h5>Are you sure you want to delete this category?</h5>
                <p>This action cannot be undone. All products in this category will lose their category association.</p>
            </div>
        </div>

        <div class="category-details">
            <div class="detail-row">
                <span class="label"> Category Name</span>
                <span class="value">@Model.CategoryName</span>
            </div>
            <div class="detail-row">
                <span class="label"> ID</span>
                <span class="value">@Model.CategoryId</span>
            </div>
            <div class="detail-row">
                <span class="label"> Description</span>
                <span class="value">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</span>
            </div>
            <div class="detail-row">
                <span class="label"> Products</span>
                <span class="value">@Model.ProductCount products</span>
            </div>
        </div>

        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-cancel"> Cancel</a>

            <form asp-action="DeleteConfirmed" asp-route-id="@Model.CategoryId" method="post" style="display: inline;">

                <button type="submit" class="btn btn-delete-category"> Delete</button>
            </form>
        </div>
    }
</div>