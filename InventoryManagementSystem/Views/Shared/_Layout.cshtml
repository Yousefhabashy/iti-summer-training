<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - InventoryManagementSystem</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />

    <style>
        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-top: 70px;
        }

        /* Navbar */
        .navbar-custom {
            background: white !important;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            padding: 0.8rem 1rem;
        }

        /* Brand */
        .navbar-custom .navbar-brand {
            font-weight: 700;
            color: #0d6efd !important;
            font-size: 1.3rem;
        }

        .navbar-custom .navbar-brand i {
            margin-right: 8px;
        }

        /* Nav Links */
        .navbar-custom .nav-link {
            color: #2c3e50 !important;
            font-weight: 500;
            padding: 0.6rem 1.2rem !important;
            border-radius: 8px;
            transition: all 0.2s;
            margin: 0 2px;
        }

        /* Hover */
        .navbar-custom .nav-link:hover {
            background: #eef2f7;
            color: #0d6efd !important;
        }

        /* Active */
        .navbar-custom .nav-link.active {
            background: #0d6efd;
            color: white !important;
        }

        /* Icons */
        .navbar-custom .nav-link i {
            margin-right: 6px;
        }

        /* Main Content */
        .main-content {
            padding: 1.5rem 2rem;
        }

        /* Content Card */
        .content-card {
            background: white;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.04);
            min-height: 400px;
        }

        /* Responsive */
        @@media (max-width: 768px) {

            .navbar-custom .nav-link {
                padding: 0.5rem 0.8rem !important;
            }

            .main-content {
                padding: 1rem;
            }
        }
    </style>
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">

        <div class="container-fluid">

            <!-- Brand -->
            <a class="navbar-brand"
               asp-area=""
               asp-controller="Products"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>
                InventoryMS

            </a>


            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Navigation -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">


                    <!-- Products -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Products" ? "active" : "")"
                           asp-area=""
                           asp-controller="Products"
                           asp-action="Index">

                            <i class="bi bi-box"></i>
                            Products

                        </a>

                    </li>


                    <!-- Categories -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Categories" ? "active" : "")"
                           asp-area=""
                           asp-controller="Categories"
                           asp-action="Index">

                            <i class="bi bi-tags"></i>
                            Categories

                        </a>

                    </li>


                    <!-- Chatbot -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Chatbot" ? "active" : "")"
                           asp-area=""
                           asp-controller="Chatbot"
                           asp-action="Index">

                            <i class="bi bi-robot"></i>
                            Chatbot

                        </a>

                    </li>


                    <!-- Purchases -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Purchases" ? "active" : "")"
                           asp-area=""
                           asp-controller="Purchases"
                           asp-action="Index">

                            <i class="bi bi-cart-plus"></i>
                            Purchases

                        </a>

                    </li>


                    <!-- Suppliers -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Suppliers" ? "active" : "")"
                           asp-area=""
                           asp-controller="Suppliers"
                           asp-action="Index">

                            <i class="bi bi-people"></i>
                            Suppliers

                        </a>

                    </li>


                    <!-- Sales -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Sales" ? "active" : "")"
                           asp-area=""
                           asp-controller="Sales"
                           asp-action="Index">

                            <i class="bi bi-graph-up-arrow"></i>
                            Sales

                        </a>

                    </li>


                    <!-- Dashboard -->
                    <li class="nav-item">

                        <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                           asp-area=""
                           asp-controller="Dashboard"
                           asp-action="Index">

                            <i class="bi bi-speedometer2"></i>
                            Dashboard

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- Main Content -->
    <div class="container main-content">

        <div class="content-card">

            @RenderBody()

        </div>

    </div>


    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>